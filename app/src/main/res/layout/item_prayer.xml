<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingVertical="10dp"
    android:paddingHorizontal="14dp"
    android:layout_marginBottom="6dp"
    android:background="@drawable/card_background_elevated">

    <ImageView
        android:id="@+id/ivPrayerCheck"
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:src="@drawable/ic_circle_outline"
        app:tint="@color/text_tertiary"
        android:contentDescription="Answered" />

    <TextView
        android:id="@+id/tvPrayerTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="12dp"
        android:textColor="@color/text_primary"
        android:textSize="14sp" />

    <ImageView
        android:id="@+id/ivDeletePrayer"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:src="@drawable/ic_close"
        app:tint="@color/text_tertiary"
        android:contentDescription="Delete" />

</LinearLayout>
