<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_dark"
    android:paddingTop="36dp">

    <!-- Top Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="20dp"
        android:paddingBottom="12dp">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/pill_background"
            android:src="@drawable/ic_close"
            android:contentDescription="Close"
            app:tint="@color/text_primary" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:text="URGE PROTOCOL"
            android:textColor="@color/emerald_accent"
            android:textSize="17sp"
            android:textStyle="bold"
            android:letterSpacing="0.12" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:overScrollMode="never"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingBottom="36dp">

            <!-- Breathing Box Container -->
            <LinearLayout
                android:id="@+id/boxBreathingContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/card_background"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="24dp"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="16dp">

                <TextView
                    android:id="@+id/tvBreathInstruction"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="INHALE DEEPLY"
                    android:textColor="@color/emerald_accent"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.1" />

                <TextView
                    android:id="@+id/tvBreathSeconds"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="4"
                    android:textColor="@color/text_primary"
                    android:textSize="64sp"
                    android:textStyle="bold"
                    android:layout_marginVertical="8dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Box Breathing: Inhale (4s) • Hold (4s) • Exhale (4s) • Hold (4s)"
                    android:textColor="@color/text_tertiary"
                    android:textSize="11sp"
                    android:gravity="center" />
            </LinearLayout>

            <!-- Intensity Selector -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/card_background"
                android:orientation="vertical"
                android:padding="20dp"
                android:layout_marginBottom="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="URGE INTENSITY (1 TO 5)"
                    android:textColor="@color/gold_primary"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.12" />

                <RadioGroup
                    android:id="@+id/rgIntensity"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:layout_marginTop="12dp">

                    <RadioButton
                        android:id="@+id/rb1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="1 Mild"
                        android:textColor="@color/text_primary"
                        android:layout_marginEnd="6dp" />

                    <RadioButton
                        android:id="@+id/rb2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="2"
                        android:textColor="@color/text_primary"
                        android:layout_marginEnd="6dp" />

                    <RadioButton
                        android:id="@+id/rb3"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="3 Med"
                        android:checked="true"
                        android:textColor="@color/text_primary"
                        android:layout_marginEnd="6dp" />

                    <RadioButton
                        android:id="@+id/rb4"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="4"
                        android:textColor="@color/text_primary"
                        android:layout_marginEnd="6dp" />

                    <RadioButton
                        android:id="@+id/rb5"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="5 Max"
                        android:textColor="@color/text_primary" />
                </RadioGroup>
            </LinearLayout>

            <!-- Trigger Selection -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/card_background"
                android:orientation="vertical"
                android:padding="20dp"
                android:layout_marginBottom="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="WHAT TRIGGERED THIS URGE?"
                    android:textColor="@color/gold_primary"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.12" />

                <EditText
                    android:id="@+id/etTriggerContext"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/card_background_elevated"
                    android:hint="e.g. Fatigue, Stress, Boredom, Late night..."
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/text_tertiary"
                    android:paddingHorizontal="14dp"
                    android:textSize="13sp"
                    android:singleLine="true" />

                <EditText
                    android:id="@+id/etThoughts"
                    android:layout_width="match_parent"
                    android:layout_height="70dp"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/card_background_elevated"
                    android:gravity="top|start"
                    android:hint="Notes / Prayer / God's Truth replacing the lie..."
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/text_tertiary"
                    android:padding="12dp"
                    android:textSize="13sp" />
            </LinearLayout>

            <!-- Victory Button -->
            <Button
                android:id="@+id/btnLogVictory"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@drawable/button_emerald"
                android:text="I Chose Discipline — Log Victory"
                android:textColor="@color/white"
                android:textSize="15sp"
                android:textStyle="bold"
                android:letterSpacing="0.05" />

        </LinearLayout>
    </ScrollView>

</LinearLayout>
