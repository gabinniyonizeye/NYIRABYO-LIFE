<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootView"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="24dp">

        <!-- Top Status Indicators -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_marginTop="20dp">

            <TextView
                android:id="@+id/tvDndStatusBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🔕 DO NOT DISTURB &amp; SILENCE ACTIVE"
                android:textColor="@color/rose_alert"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.1"
                android:background="@drawable/pill_background"
                android:paddingHorizontal="14dp"
                android:paddingVertical="6dp" />

            <TextView
                android:id="@+id/tvModeBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="STUDY FOCUS 🎯"
                android:textColor="@color/gold_primary"
                android:textSize="12sp"
                android:textStyle="bold"
                android:letterSpacing="0.08"
                android:background="@drawable/pill_background"
                android:paddingHorizontal="12dp"
                android:paddingVertical="4dp" />
        </LinearLayout>

        <!-- Task Title & Window -->
        <TextView
            android:id="@+id/tvTaskTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text=".NET Coding Mastery"
            android:textColor="@color/text_primary"
            android:textSize="24sp"
            android:textStyle="bold"
            android:gravity="center" />

        <TextView
            android:id="@+id/tvTimeWindow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="09:00 - 12:00 (3 hours)"
            android:textColor="@color/gold_primary"
            android:textSize="14sp"
            android:textStyle="bold" />

        <!-- Massive Countdown Display Card -->
        <LinearLayout
            android:id="@+id/cardCountdown"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_marginTop="28dp"
            android:padding="28dp"
            android:background="@drawable/card_background_elevated">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="TIME REMAINING UNTIL NORMAL MODE"
                android:textColor="@color/text_secondary"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.12" />

            <TextView
                android:id="@+id/tvCountdown"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="02:59:45"
                android:textColor="@color/text_primary"
                android:textSize="48sp"
                android:textStyle="bold"
                android:fontFamily="monospace"
                android:letterSpacing="0.05" />

            <ProgressBar
                android:id="@+id/progressBarFocus"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="8dp"
                android:layout_marginTop="16dp"
                android:max="1000"
                android:progress="1000"
                android:progressTint="@color/gold_primary"
                android:progressBackgroundTint="@color/border_subtle" />

            <TextView
                android:id="@+id/tvEndTimeNotice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Focus session ends automatically at 12:00"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Christ Anchor / Scripture Motivation Card -->
        <LinearLayout
            android:id="@+id/cardScripture"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="20dp"
            android:padding="18dp"
            android:background="@drawable/card_background">

            <TextView
                android:id="@+id/tvScriptureRef"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="COLOSSIANS 3:23"
                android:textColor="@color/gold_primary"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.1" />

            <TextView
                android:id="@+id/tvScriptureText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="“Whatever you do, work heartily, as for the Lord and not for men.”"
                android:textColor="@color/text_primary"
                android:textSize="13sp"
                android:lineSpacingExtra="3dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="🛡️ Distractions &amp; social media are locked until the session finishes."
                android:textColor="@color/text_tertiary"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Bottom Actions -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_marginTop="32dp"
            android:layout_marginBottom="24dp">

            <Button
                android:id="@+id/btnCompleteEarly"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@drawable/button_gold"
                android:text="Session Finished: Return to Normal Mode"
                android:textColor="@color/bg_dark"
                android:textSize="13sp"
                android:textStyle="bold"
                android:letterSpacing="0.04" />

            <Button
                android:id="@+id/btnEmergencyExit"
                style="?attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Emergency Exit (Requires PIN)"
                android:textColor="@color/text_tertiary"
                android:textSize="12sp" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>

