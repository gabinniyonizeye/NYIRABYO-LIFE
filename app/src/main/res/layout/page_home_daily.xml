<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:overScrollMode="never"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="6dp"
        android:paddingBottom="12dp">

        <!-- Digital Clock & Sacred Date Section -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_marginTop="0dp"
            android:layout_marginBottom="8dp">

            <TextClock
                android:id="@+id/textClockTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:format12Hour="hh:mm"
                android:format24Hour="HH:mm"
                android:textColor="@color/text_primary"
                android:textSize="32sp"
                android:textStyle="bold"
                android:letterSpacing="0.02" />

            <TextClock
                android:id="@+id/textClockDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:format12Hour="EEEE, MMMM d"
                android:format24Hour="EEEE, MMMM d"
                android:textColor="@color/text_secondary"
                android:textSize="10sp"
                android:letterSpacing="0.08"
                android:textAllCaps="true" />

            <TextView
                android:id="@+id/tvSacredHabitationBanner"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="HOLY HABITATION • ABIDING IN CHRIST"
                android:textColor="@color/gold_primary"
                android:textSize="9sp"
                android:textStyle="bold"
                android:letterSpacing="0.14" />
        </LinearLayout>

        <!-- KNOWING GOD & HIS SON / BIBLE STUDY & HABIT HABITATION Card -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/cardTodayWord"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/card_background_elevated"
            android:padding="12dp"
            android:layout_marginBottom="8dp"
            android:foreground="?attr/selectableItemBackground">

            <ImageView
                android:id="@+id/ivSparkleGod"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:src="@drawable/ic_sparkle"
                app:tint="@color/gold_primary"
                android:contentDescription="Celestial Light"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent" />

            <TextView
                android:id="@+id/lblWordBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="HOLY HABITATION • BIBLE STUDY FOCUS"
                android:textColor="@color/gold_primary"
                android:textSize="10sp"
                android:textStyle="bold"
                android:letterSpacing="0.12"
                app:layout_constraintTop_toTopOf="@id/ivSparkleGod"
                app:layout_constraintBottom_toBottomOf="@id/ivSparkleGod"
                app:layout_constraintStart_toEndOf="@id/ivSparkleGod" />

            <TextView
                android:id="@+id/tvRevelationTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Holy Habitation: Abiding in the Vine"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                android:textStyle="bold"
                app:layout_constraintTop_toBottomOf="@id/lblWordBadge"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <TextView
                android:id="@+id/tvVerseText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="“Remain in me, as I also remain in you. Apart from me you can do nothing.”"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:maxLines="2"
                android:ellipsize="end"
                android:lineSpacingExtra="2dp"
                app:layout_constraintTop_toBottomOf="@id/tvRevelationTitle"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <TextView
                android:id="@+id/tvVerseRef"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="John 15:4-5"
                android:textColor="@color/gold_primary"
                android:textSize="11sp"
                android:textStyle="bold"
                app:layout_constraintTop_toBottomOf="@id/tvVerseText"
                app:layout_constraintStart_toStartOf="parent" />

            <TextView
                android:id="@+id/tvReflectPrompt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Bible Study &amp; Presence →"
                android:textColor="@color/emerald_accent"
                android:textSize="11sp"
                android:textStyle="bold"
                app:layout_constraintBottom_toBottomOf="@id/tvVerseRef"
                app:layout_constraintEnd_toEndOf="parent" />
        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- TODAY'S MISSION & HABIT DISCIPLINE Card (Fully Synced with Weekly Plan) -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/cardTodayMission"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/card_background"
            android:padding="12dp">

            <TextView
                android:id="@+id/lblMissionHeader"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Today's Mission"
                android:textColor="@color/text_primary"
                android:textSize="15sp"
                android:textStyle="bold"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent" />

            <TextView
                android:id="@+id/tvMissionSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SYNCED WITH WEEKLY PLAN • HABIT REWIRING ⏰"
                android:textColor="@color/gold_primary"
                android:textSize="9sp"
                android:textStyle="bold"
                android:letterSpacing="0.08"
                android:layout_marginTop="2dp"
                app:layout_constraintTop_toBottomOf="@id/lblMissionHeader"
                app:layout_constraintStart_toStartOf="parent" />

            <TextView
                android:id="@+id/tvMissionCounter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0 of 3 complete"
                android:textColor="@color/emerald_accent"
                android:textSize="12sp"
                android:textStyle="bold"
                app:layout_constraintBaseline_toBaselineOf="@id/lblMissionHeader"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- Progress Bar -->
            <ProgressBar
                android:id="@+id/progressBarMissions"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="0dp"
                android:layout_height="4dp"
                android:layout_marginTop="8dp"
                android:max="3"
                android:progress="0"
                android:progressTint="@color/emerald_accent"
                android:progressBackgroundTint="@color/border_subtle"
                app:layout_constraintTop_toBottomOf="@id/tvMissionSubtitle"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- Dynamic missions container synchronized with weekly plan -->
            <LinearLayout
                android:id="@+id/layoutMissionsContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="6dp"
                app:layout_constraintTop_toBottomOf="@id/progressBarMissions"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- Bottom Action Row: Weekly Plan + Edit Priorities -->
            <LinearLayout
                android:id="@+id/layoutMissionActions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="8dp"
                app:layout_constraintTop_toBottomOf="@id/layoutMissionsContainer"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <!-- 7-Day Weekly Plan Entry Point -->
                <TextView
                    android:id="@+id/btnOpenWeeklyPlan"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Weekly Plan 📅 →"
                    android:textColor="@color/emerald_accent"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:paddingVertical="4dp"
                    android:paddingEnd="8dp"
                    android:foreground="?attr/selectableItemBackground" />

                <TextView
                    android:id="@+id/btnSanctuaryCheckIn"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Reminder 🔔"
                    android:textColor="@color/gold_primary"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:paddingVertical="4dp"
                    android:paddingHorizontal="8dp"
                    android:foreground="?attr/selectableItemBackground" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <!-- Edit Priorities -->
                <TextView
                    android:id="@+id/btnEditMissions"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Edit Priorities ✏️"
                    android:textColor="@color/text_tertiary"
                    android:textSize="11sp"
                    android:paddingVertical="4dp"
                    android:paddingStart="12dp"
                    android:foreground="?attr/selectableItemBackground" />
            </LinearLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>