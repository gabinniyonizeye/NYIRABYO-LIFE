<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/bg_dark">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="24dp">

        <!-- Header Tag -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="NYIRABYO DISCIPLINE LOCK"
            android:textColor="@color/gold_primary"
            android:textSize="13sp"
            android:textStyle="bold"
            android:letterSpacing="0.2" />

        <!-- Big Minimalist Clock -->
        <TextClock
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:format12Hour="hh:mm"
            android:format24Hour="HH:mm"
            android:textColor="@color/text_primary"
            android:textSize="60sp"
            android:textStyle="bold"
            android:letterSpacing="0.02"
            android:layout_marginTop="8dp" />

        <TextClock
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:format12Hour="EEEE, MMMM d"
            android:format24Hour="EEEE, MMMM d"
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            android:letterSpacing="0.08"
            android:textAllCaps="true"
            android:layout_marginBottom="16dp" />

        <!-- ESCAPE ROOM 1-HOUR LOCKDOWN BANNER (Visible when Active) -->
        <LinearLayout
            android:id="@+id/cardEscapeRoomBanner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/card_background_elevated"
            android:orientation="vertical"
            android:padding="16dp"
            android:layout_marginBottom="18dp"
            android:gravity="center"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_shield"
                    app:tint="@color/gold_primary" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="ESCAPE ROOM TOTAL LOCKDOWN"
                    android:textColor="@color/gold_primary"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.1" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvEscapeRoomCountdown"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="60:00 REMAINING"
                android:textColor="@color/white"
                android:textSize="22sp"
                android:textStyle="bold"
                android:letterSpacing="0.05" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="All apps shut • Phone calls permitted"
                android:textColor="@color/text_tertiary"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Scripture Anchor Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/card_background"
            android:orientation="vertical"
            android:padding="18dp"
            android:layout_marginBottom="20dp">

            <TextView
                android:id="@+id/tvLockVerseText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="“Seek first the kingdom of God and his righteousness, and all these things will be added to you.”"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                android:lineSpacingExtra="4dp"
                android:gravity="center" />

            <TextView
                android:id="@+id/tvLockVerseRef"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_gravity="center"
                android:text="Matthew 6:33"
                android:textColor="@color/gold_primary"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Today's 3 Missions Priorities -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/card_background_elevated"
            android:orientation="vertical"
            android:padding="18dp"
            android:layout_marginBottom="24dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="12dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="TODAY'S MISSION"
                    android:textColor="@color/text_tertiary"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.1" />

                <TextView
                    android:id="@+id/tvLockMissionSummary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0 of 3 complete"
                    android:textColor="@color/emerald_accent"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Mission 1 -->
            <LinearLayout
                android:id="@+id/rowLockMission1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingVertical="6dp">

                <ImageView
                    android:id="@+id/ivLockCheck1"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@drawable/ic_circle_outline"
                    app:tint="@color/text_tertiary" />

                <TextView
                    android:id="@+id/tvLockMissionTitle1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:text="Pray and read Scripture"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp" />
            </LinearLayout>

            <!-- Mission 2 -->
            <LinearLayout
                android:id="@+id/rowLockMission2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingVertical="6dp">

                <ImageView
                    android:id="@+id/ivLockCheck2"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@drawable/ic_circle_outline"
                    app:tint="@color/text_tertiary" />

                <TextView
                    android:id="@+id/tvLockMissionTitle2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:text="Build my future — coding"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp" />
            </LinearLayout>

            <!-- Mission 3 -->
            <LinearLayout
                android:id="@+id/rowLockMission3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingVertical="6dp">

                <ImageView
                    android:id="@+id/ivLockCheck3"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@drawable/ic_circle_outline"
                    app:tint="@color/text_tertiary" />

                <TextView
                    android:id="@+id/tvLockMissionTitle3"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:text="Train my body — basketball"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp" />
            </LinearLayout>

        </LinearLayout>

        <!-- Unlock Button -->
        <Button
            android:id="@+id/btnUnlock"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="@drawable/button_gold"
            android:text="Unlock Device"
            android:textColor="@color/bg_dark"
            android:textSize="15sp"
            android:textStyle="bold"
            android:letterSpacing="0.05"
            android:layout_marginBottom="12dp" />

        <!-- Phone & Calls Button -->
        <Button
            android:id="@+id/btnLockPhone"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="Phone / Calls"
            android:textColor="@color/emerald_accent"
            app:strokeColor="@color/emerald_accent"
            app:icon="@drawable/ic_phone"
            app:iconTint="@color/emerald_accent"
            android:textSize="13sp"
            android:textStyle="bold"
            android:letterSpacing="0.05"
            android:layout_marginBottom="12dp" />

        <!-- Emergency Urge Protocol -->
        <Button
            android:id="@+id/btnLockUrge"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:text="Emergency Urge Protocol →"
            android:textColor="@color/rose_alert"
            android:textSize="13sp"
            android:layout_marginBottom="16dp" />

    </LinearLayout>
</ScrollView>
