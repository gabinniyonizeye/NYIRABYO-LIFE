<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_dark"
    android:paddingTop="36dp">

    <!-- Top Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="20dp"
        android:paddingBottom="12dp">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/pill_background"
            android:src="@drawable/ic_arrow_back"
            android:contentDescription="Back"
            app:tint="@color/text_primary" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="14dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="DEEP FOCUS"
                android:textColor="@color/indigo_focus"
                android:textSize="17sp"
                android:textStyle="bold"
                android:letterSpacing="0.12" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Distraction-Free Immersion"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:overScrollMode="never"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingBottom="36dp">

            <!-- Mode Selector Chips -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="16dp">

                <TextView
                    android:id="@+id/btnModeCoding"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:background="@drawable/pill_background"
                    android:text="Coding"
                    android:textColor="@color/indigo_focus"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:layout_marginEnd="4dp" />

                <TextView
                    android:id="@+id/btnModeTraining"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:background="@drawable/pill_background"
                    android:text="Training"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp"
                    android:layout_marginEnd="4dp" />

                <TextView
                    android:id="@+id/btnModePrayer"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:background="@drawable/pill_background"
                    android:text="Prayer"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp"
                    android:layout_marginEnd="4dp" />

                <TextView
                    android:id="@+id/btnModeSleep"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:background="@drawable/pill_background"
                    android:text="Sleep"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- Big Circular Countdown Container -->
            <LinearLayout
                android:id="@+id/cardFocusCenter"
                android:layout_width="match_parent"
                android:layout_height="260dp"
                android:background="@drawable/card_background"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="20dp"
                android:layout_marginBottom="16dp">

                <TextView
                    android:id="@+id/tvFocusModeLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="BUILD MY FUTURE — CODING"
                    android:textColor="@color/indigo_focus"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.15" />

                <TextView
                    android:id="@+id/tvTimerCountdown"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="25:00"
                    android:textColor="@color/text_primary"
                    android:textSize="64sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.02"
                    android:layout_marginVertical="10dp" />

                <TextView
                    android:id="@+id/tvFocusQuote"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="“Whatever your hand finds to do, do it with your might.”"
                    android:textColor="@color/text_tertiary"
                    android:textSize="12sp"
                    android:gravity="center"
                    android:paddingHorizontal="16dp" />
            </LinearLayout>

            <!-- Duration Presets -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="20dp">

                <TextView
                    android:id="@+id/preset15"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:background="@drawable/card_background_elevated"
                    android:text="15m"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp"
                    android:layout_marginEnd="6dp" />

                <TextView
                    android:id="@+id/preset25"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:background="@drawable/button_gold"
                    android:text="25m"
                    android:textColor="@color/bg_dark"
                    android:textStyle="bold"
                    android:textSize="12sp"
                    android:layout_marginEnd="6dp" />

                <TextView
                    android:id="@+id/preset45"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:background="@drawable/card_background_elevated"
                    android:text="45m"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp"
                    android:layout_marginEnd="6dp" />

                <TextView
                    android:id="@+id/preset60"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:background="@drawable/card_background_elevated"
                    android:text="60m"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- Controls: Start / Pause & Reset -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnToggleTimer"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_weight="1"
                    android:background="@drawable/button_gold"
                    android:text="Start Session"
                    android:textColor="@color/bg_dark"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:layout_marginEnd="10dp" />

                <ImageButton
                    android:id="@+id/btnResetTimer"
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:background="@drawable/card_background_elevated"
                    android:src="@drawable/ic_refresh"
                    app:tint="@color/text_secondary"
                    android:contentDescription="Reset" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

</LinearLayout>
