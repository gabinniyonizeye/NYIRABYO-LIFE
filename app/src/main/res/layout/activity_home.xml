<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rootHome"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark">

    <!-- Top Status / Header Bar -->
    <LinearLayout
        android:id="@+id/headerLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="24dp"
        android:paddingTop="24dp"
        android:paddingBottom="8dp"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="NYIRABYO LIFE"
                android:textColor="@color/gold_primary"
                android:textSize="18sp"
                android:textStyle="bold"
                android:letterSpacing="0.15" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Live with purpose."
                android:textColor="@color/text_secondary"
                android:textSize="13sp"
                android:letterSpacing="0.05" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/btnLockMode"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/pill_background"
            android:src="@drawable/ic_lock"
            android:contentDescription="Discipline Lock"
            android:layout_marginEnd="8dp"
            app:tint="@color/gold_primary" />

        <ImageButton
            android:id="@+id/btnSettings"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/pill_background"
            android:src="@drawable/ic_settings"
            android:contentDescription="Settings"
            app:tint="@color/text_secondary" />
    </LinearLayout>

    <!-- Horizontal Slides (ViewPager2) -->
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/homeViewPager"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:overScrollMode="never"
        app:layout_constraintTop_toBottomOf="@id/headerLayout"
        app:layout_constraintBottom_toTopOf="@id/layoutPageIndicator" />

    <!-- Slide Page Indicator Dots -->
    <LinearLayout
        android:id="@+id/layoutPageIndicator"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:paddingVertical="6dp"
        app:layout_constraintTop_toBottomOf="@id/homeViewPager"
        app:layout_constraintBottom_toTopOf="@id/bottomDock"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <View
            android:id="@+id/dot1"
            android:layout_width="18dp"
            android:layout_height="6dp"
            android:background="@drawable/indicator_dot_active"
            android:layout_marginHorizontal="4dp" />

        <View
            android:id="@+id/dot2"
            android:layout_width="6dp"
            android:layout_height="6dp"
            android:background="@drawable/indicator_dot_inactive"
            android:layout_marginHorizontal="4dp" />

        <View
            android:id="@+id/dot3"
            android:layout_width="6dp"
            android:layout_height="6dp"
            android:background="@drawable/indicator_dot_inactive"
            android:layout_marginHorizontal="4dp" />
    </LinearLayout>

    <!-- Bottom Dock: Favorite Apps & App Drawer Launcher -->
    <LinearLayout
        android:id="@+id/bottomDock"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="8dp"
        android:paddingBottom="12dp"
        android:background="@drawable/pill_background"
        android:layout_marginHorizontal="16dp"
        android:layout_marginBottom="12dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <!-- Favorite Apps Row -->
        <LinearLayout
            android:id="@+id/layoutFavorites"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginBottom="10dp" />

        <!-- Search / All Apps Pill Button -->
        <LinearLayout
            android:id="@+id/btnOpenAppDrawer"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:background="@drawable/card_background"
            android:orientation="horizontal"
            android:gravity="center"
            android:foreground="?attr/selectableItemBackground">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_apps"
                app:tint="@color/gold_primary"
                android:contentDescription="Apps" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:text="All Applications"
                android:textColor="@color/text_secondary"
                android:textSize="13sp"
                android:letterSpacing="0.05" />
        </LinearLayout>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
