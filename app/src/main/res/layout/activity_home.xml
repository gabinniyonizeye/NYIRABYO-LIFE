<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rootHome"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark">

    <!-- Living Ambient Spiritual Glow Wallpaper Behind Slides -->
    <com.example.nyirabyolife.ui.home.AmbientGlowView
        android:id="@+id/ambientGlowView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Top Status / Header Bar -->
    <LinearLayout
        android:id="@+id/headerLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="20dp"
        android:paddingBottom="6dp"
        app:layout_constraintTop_toTopOf="parent">

        <!-- Top Title Row: Full width for NYIRABYO LIFE -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tvHeaderTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="NYIRABYO LIFE"
                android:textColor="@color/gold_primary"
                android:textSize="20sp"
                android:textStyle="bold"
                android:singleLine="true"
                android:letterSpacing="0.12" />

            <ImageButton
                android:id="@+id/btnLockMode"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/pill_background"
                android:src="@drawable/ic_lock"
                android:contentDescription="Discipline Lock"
                android:layout_marginEnd="6dp"
                app:tint="@color/gold_primary" />

            <ImageButton
                android:id="@+id/btnSettings"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/pill_background"
                android:src="@drawable/ic_settings"
                android:contentDescription="Settings"
                app:tint="@color/text_secondary" />
        </LinearLayout>

        <!-- Sub Row: Subtitle + Quick Theme and Meditation Pills -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="4dp">

            <TextView
                android:id="@+id/tvHeaderSubtitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Holy Habitation • Live with Purpose"
                android:textColor="@color/text_secondary"
                android:textSize="11sp"
                android:singleLine="true"
                android:letterSpacing="0.04" />

            <TextView
                android:id="@+id/btnTheme"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:gravity="center"
                android:paddingHorizontal="10dp"
                android:text="🎨 Theme"
                android:textColor="@color/text_secondary"
                android:textSize="11sp"
                android:textStyle="bold"
                android:background="@drawable/pill_background"
                android:foreground="?attr/selectableItemBackground"
                android:layout_marginEnd="6dp" />

            <TextView
                android:id="@+id/btnMeditate"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:gravity="center"
                android:paddingHorizontal="12dp"
                android:text="🕊️ Meditate"
                android:textColor="@color/gold_primary"
                android:textSize="11sp"
                android:textStyle="bold"
                android:background="@drawable/pill_background"
                android:foreground="?attr/selectableItemBackground" />
        </LinearLayout>
    </LinearLayout>

    <!-- Horizontal Slides (ViewPager2) -->
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/homeViewPager"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:overScrollMode="never"
        app:layout_constraintTop_toBottomOf="@id/headerLayout"
        app:layout_constraintBottom_toTopOf="@id/layoutPageIndicator" />

    <!-- Slide Page Indicator Dots -->
    <LinearLayout
        android:id="@+id/layoutPageIndicator"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:paddingVertical="6dp"
        app:layout_constraintTop_toBottomOf="@id/homeViewPager"
        app:layout_constraintBottom_toTopOf="@id/bottomDock"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <View
            android:id="@+id/dot1"
            android:layout_width="18dp"
            android:layout_height="6dp"
            android:background="@drawable/indicator_dot_active"
            android:layout_marginHorizontal="4dp" />

        <View
            android:id="@+id/dot2"
            android:layout_width="6dp"
            android:layout_height="6dp"
            android:background="@drawable/indicator_dot_inactive"
            android:layout_marginHorizontal="4dp" />

        <View
            android:id="@+id/dot3"
            android:layout_width="6dp"
            android:layout_height="6dp"
            android:background="@drawable/indicator_dot_inactive"
            android:layout_marginHorizontal="4dp" />
    </LinearLayout>

    <!-- Bottom Dock: Phone & App Drawer Launcher -->
    <LinearLayout
        android:id="@+id/bottomDock"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="6dp"
        android:paddingBottom="8dp"
        android:background="@drawable/pill_background"
        android:layout_marginHorizontal="16dp"
        android:layout_marginBottom="10dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <!-- Phone icon row -->
        <LinearLayout
            android:id="@+id/layoutFavorites"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginBottom="6dp" />

        <!-- All Applications button -->
        <LinearLayout
            android:id="@+id/btnOpenAppDrawer"
            android:layout_width="match_parent"
            android:layout_height="38dp"
            android:background="@drawable/card_background"
            android:orientation="horizontal"
            android:gravity="center"
            android:foreground="?attr/selectableItemBackground">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_apps"
                app:tint="@color/gold_primary"
                android:contentDescription="Apps" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="All Applications"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:letterSpacing="0.05" />
        </LinearLayout>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
