<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="@drawable/card_background">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="TASK TITLE"
        android:textColor="@color/gold_primary"
        android:textSize="11sp"
        android:textStyle="bold"
        android:letterSpacing="0.12" />

    <EditText
        android:id="@+id/etTaskTitle"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="6dp"
        android:background="@drawable/card_background_elevated"
        android:hint="e.g. Deep Coding / Prayer / BedTime"
        android:textColor="@color/text_primary"
        android:textColorHint="@color/text_tertiary"
        android:paddingHorizontal="14dp"
        android:textSize="14sp"
        android:singleLine="true" />

    <!-- Recurrence Selection: Daily vs Weekly -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="RECURRENCE (DAILY OR WEEKLY)"
        android:textColor="@color/gold_primary"
        android:textSize="11sp"
        android:textStyle="bold"
        android:letterSpacing="0.12"
        android:layout_marginTop="14dp" />

    <Spinner
        android:id="@+id/spinnerRecurrence"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:layout_marginTop="6dp"
        android:background="@drawable/card_background_elevated"
        android:paddingHorizontal="12dp" />

    <!-- Day of Week Selection (Shown for Weekly, hidden or marked for Daily) -->
    <LinearLayout
        android:id="@+id/layoutDaySelection"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="14dp">

        <TextView
            android:id="@+id/lblDayOfWeek"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="DAY OF WEEK"
            android:textColor="@color/gold_primary"
            android:textSize="11sp"
            android:textStyle="bold"
            android:letterSpacing="0.12" />

        <Spinner
            android:id="@+id/spinnerDayOfWeek"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/card_background_elevated"
            android:paddingHorizontal="12dp" />
    </LinearLayout>

    <!-- Discipline / Focus Mode Preset -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="TASK FOCUS / DISCIPLINE PRESET"
        android:textColor="@color/gold_primary"
        android:textSize="11sp"
        android:textStyle="bold"
        android:letterSpacing="0.12"
        android:layout_marginTop="14dp" />

    <Spinner
        android:id="@+id/spinnerTaskMode"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:layout_marginTop="6dp"
        android:background="@drawable/card_background_elevated"
        android:paddingHorizontal="12dp" />

    <!-- Time Setting Row -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="TIME (24-HOUR / ALARM)"
        android:textColor="@color/gold_primary"
        android:textSize="11sp"
        android:textStyle="bold"
        android:letterSpacing="0.12"
        android:layout_marginTop="14dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="6dp">

        <EditText
            android:id="@+id/etHour"
            android:layout_width="70dp"
            android:layout_height="46dp"
            android:background="@drawable/card_background_elevated"
            android:hint="HH"
            android:inputType="number"
            android:maxLength="2"
            android:gravity="center"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_tertiary"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=":"
            android:textColor="@color/text_primary"
            android:textSize="20sp"
            android:textStyle="bold"
            android:paddingHorizontal="8dp" />

        <EditText
            android:id="@+id/etMinute"
            android:layout_width="70dp"
            android:layout_height="46dp"
            android:background="@drawable/card_background_elevated"
            android:hint="MM"
            android:inputType="number"
            android:maxLength="2"
            android:gravity="center"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_tertiary"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvQuickPresets"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:text="Presets: 07:00, 07:10, 22:00"
            android:textColor="@color/text_tertiary"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- Loud Alarm Ringtone Switch -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="16dp"
        android:padding="12dp"
        android:background="@drawable/card_background_elevated">

        <ImageView
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:src="@drawable/ic_alarm"
            app:tint="@color/gold_primary"
            android:contentDescription="Alarm" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Sound Loud Alarm Ringtone"
                android:textColor="@color/text_primary"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Full-screen ringtone like an alarm clock"
                android:textColor="@color/text_secondary"
                android:textSize="11sp" />
        </LinearLayout>

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/switchAlarm"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checked="true"
            app:thumbTint="@color/gold_primary"
            app:trackTint="@color/border_subtle" />
    </LinearLayout>

</LinearLayout>
