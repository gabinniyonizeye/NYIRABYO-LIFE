<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_dark"
    android:paddingTop="36dp">

    <!-- Top Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="20dp"
        android:paddingBottom="12dp">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/pill_background"
            android:src="@drawable/ic_arrow_back"
            android:contentDescription="Back"
            app:tint="@color/text_primary" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="14dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="GUARDIAN PERMISSIONS"
                android:textColor="@color/gold_primary"
                android:textSize="17sp"
                android:textStyle="bold"
                android:letterSpacing="0.12" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Enable real OS-level controls"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:overScrollMode="never"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingBottom="36dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="For NYIRABYO LIFE to strictly enforce your discipline rules, block distracting apps in real time, and protect your focus sessions, enable the following Android controls:"
                android:textColor="@color/text_secondary"
                android:textSize="13sp"
                android:lineSpacingExtra="3dp"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="16dp" />

            <!-- 1. Default Launcher Card -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/cardPermLauncher"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/card_background"
                android:padding="18dp"
                android:layout_marginBottom="12dp"
                android:foreground="?attr/selectableItemBackground">

                <TextView
                    android:id="@+id/lblPermLauncher"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="1. Default Home Launcher"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toStartOf="@id/badgeLauncher" />

                <TextView
                    android:id="@+id/badgeLauncher"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Needs Action"
                    android:textColor="@color/gold_primary"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintEnd_toEndOf="parent" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Ensures the home button always returns to NYIRABYO LIFE instead of a distracting launcher."
                    android:textColor="@color/text_tertiary"
                    android:textSize="12sp"
                    app:layout_constraintTop_toBottomOf="@id/lblPermLauncher"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent" />
            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- 2. Accessibility Guardian Service Card -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/cardPermAccessibility"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/card_background"
                android:padding="18dp"
                android:layout_marginBottom="12dp"
                android:foreground="?attr/selectableItemBackground">

                <TextView
                    android:id="@+id/lblPermAccessibility"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="2. Guardian Service (Live Blocker)"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toStartOf="@id/badgeAccessibility" />

                <TextView
                    android:id="@+id/badgeAccessibility"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Needs Action"
                    android:textColor="@color/gold_primary"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintEnd_toEndOf="parent" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Allows the Guardian to detect when restricted apps are launched and instantly show the discipline shield."
                    android:textColor="@color/text_tertiary"
                    android:textSize="12sp"
                    app:layout_constraintTop_toBottomOf="@id/lblPermAccessibility"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent" />
            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- 3. Usage Stats Card -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/cardPermUsage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/card_background"
                android:padding="18dp"
                android:layout_marginBottom="12dp"
                android:foreground="?attr/selectableItemBackground">

                <TextView
                    android:id="@+id/lblPermUsage"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="3. App Usage Tracking"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toStartOf="@id/badgeUsage" />

                <TextView
                    android:id="@+id/badgeUsage"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Needs Action"
                    android:textColor="@color/gold_primary"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintEnd_toEndOf="parent" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Enables measuring daily screen time and enforce app daily time limits."
                    android:textColor="@color/text_tertiary"
                    android:textSize="12sp"
                    app:layout_constraintTop_toBottomOf="@id/lblPermUsage"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent" />
            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- 4. Overlay Permission Card -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/cardPermOverlay"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/card_background"
                android:padding="18dp"
                android:layout_marginBottom="12dp"
                android:foreground="?attr/selectableItemBackground">

                <TextView
                    android:id="@+id/lblPermOverlay"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="4. Display Over Other Apps"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toStartOf="@id/badgeOverlay" />

                <TextView
                    android:id="@+id/badgeOverlay"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Needs Action"
                    android:textColor="@color/gold_primary"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintEnd_toEndOf="parent" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Allows the shield to pop up immediately over any distracting app without delay."
                    android:textColor="@color/text_tertiary"
                    android:textSize="12sp"
                    app:layout_constraintTop_toBottomOf="@id/lblPermOverlay"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent" />
            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- 5. Do Not Disturb Card -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/cardPermDnd"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/card_background"
                android:padding="18dp"
                android:layout_marginBottom="16dp"
                android:foreground="?attr/selectableItemBackground">

                <TextView
                    android:id="@+id/lblPermDnd"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="5. Do Not Disturb Access"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toStartOf="@id/badgeDnd" />

                <TextView
                    android:id="@+id/badgeDnd"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Needs Action"
                    android:textColor="@color/gold_primary"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintEnd_toEndOf="parent" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Silences notification buzzes automatically during Deep Focus and Sleep sessions."
                    android:textColor="@color/text_tertiary"
                    android:textSize="12sp"
                    app:layout_constraintTop_toBottomOf="@id/lblPermDnd"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent" />
            </androidx.constraintlayout.widget.ConstraintLayout>

        </LinearLayout>
    </ScrollView>

</LinearLayout>
