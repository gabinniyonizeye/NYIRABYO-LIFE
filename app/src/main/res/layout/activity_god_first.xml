<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_dark"
    android:paddingTop="36dp">

    <!-- Top Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="20dp"
        android:paddingBottom="12dp">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/pill_background"
            android:src="@drawable/ic_arrow_back"
            android:contentDescription="Back"
            app:tint="@color/text_primary" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="14dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="GOD FIRST"
                android:textColor="@color/gold_primary"
                android:textSize="17sp"
                android:textStyle="bold"
                android:letterSpacing="0.12" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Scripture, Prayer &amp; Gratitude"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:overScrollMode="never"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingBottom="36dp">

            <!-- Today's Word in Full Detail -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/card_background"
                android:padding="20dp"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="16dp">

                <ImageView
                    android:id="@+id/ivCrossIcon"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_book"
                    app:tint="@color/gold_primary"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    android:contentDescription="Scripture" />

                <TextView
                    android:id="@+id/tvThemeBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:text="PRIORITIES &amp; PURPOSE"
                    android:textColor="@color/gold_primary"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.15"
                    app:layout_constraintTop_toTopOf="@id/ivCrossIcon"
                    app:layout_constraintBottom_toBottomOf="@id/ivCrossIcon"
                    app:layout_constraintStart_toEndOf="@id/ivCrossIcon" />

                <TextView
                    android:id="@+id/tvFullVerse"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="“Seek first the kingdom of God and his righteousness, and all these things will be added to you.”"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp"
                    android:lineSpacingExtra="5dp"
                    app:layout_constraintTop_toBottomOf="@id/ivCrossIcon"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent" />

                <TextView
                    android:id="@+id/tvFullRef"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="Matthew 6:33"
                    android:textColor="@color/gold_primary"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    app:layout_constraintTop_toBottomOf="@id/tvFullVerse"
                    app:layout_constraintStart_toStartOf="parent" />

                <!-- Reflection Prompt Box -->
                <LinearLayout
                    android:id="@+id/boxReflection"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/card_background_elevated"
                    android:orientation="vertical"
                    android:padding="14dp"
                    app:layout_constraintTop_toBottomOf="@id/tvFullRef">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="DAILY REFLECTION"
                        android:textColor="@color/text_secondary"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.1" />

                    <TextView
                        android:id="@+id/tvReflectionPrompt"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="What is the single most important action in your day that aligns with God's purpose?"
                        android:textColor="@color/text_primary"
                        android:textSize="13sp"
                        android:lineSpacingExtra="3dp" />
                </LinearLayout>

                <Button
                    android:id="@+id/btnCycleVerse"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Next Verse →"
                    android:textColor="@color/gold_primary"
                    android:textSize="12sp"
                    app:layout_constraintTop_toBottomOf="@id/boxReflection"
                    app:layout_constraintEnd_toEndOf="parent" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- PRAYER CHECKLIST SECTION -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/card_background"
                android:padding="20dp"
                android:layout_marginBottom="16dp">

                <TextView
                    android:id="@+id/lblPrayerHeader"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Prayer Intentions"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent" />

                <!-- Add prayer row -->
                <LinearLayout
                    android:id="@+id/layoutAddPrayer"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:orientation="horizontal"
                    android:layout_marginTop="12dp"
                    app:layout_constraintTop_toBottomOf="@id/lblPrayerHeader">

                    <EditText
                        android:id="@+id/etNewPrayer"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@drawable/card_background_elevated"
                        android:hint="Add prayer intention..."
                        android:textColor="@color/text_primary"
                        android:textColorHint="@color/text_tertiary"
                        android:paddingHorizontal="14dp"
                        android:textSize="13sp"
                        android:imeOptions="actionDone"
                        android:singleLine="true" />

                    <ImageButton
                        android:id="@+id/btnAddPrayer"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/button_gold"
                        android:src="@drawable/ic_add"
                        android:contentDescription="Add Prayer"
                        app:tint="@color/bg_dark" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/layoutPrayerList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginTop="12dp"
                    app:layout_constraintTop_toBottomOf="@id/layoutAddPrayer" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- GRATITUDE JOURNAL SECTION -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/card_background"
                android:padding="20dp">

                <ImageView
                    android:id="@+id/ivGratitudeHeart"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_heart"
                    app:tint="@color/rose_alert"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    android:contentDescription="Heart" />

                <TextView
                    android:id="@+id/lblGratitudeHeader"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="Daily Gratitude"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    app:layout_constraintTop_toTopOf="@id/ivGratitudeHeart"
                    app:layout_constraintBottom_toBottomOf="@id/ivGratitudeHeart"
                    app:layout_constraintStart_toEndOf="@id/ivGratitudeHeart" />

                <TextView
                    android:id="@+id/lblGratitudeSub"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Name what you thank God for today:"
                    android:textColor="@color/text_tertiary"
                    android:textSize="12sp"
                    app:layout_constraintTop_toBottomOf="@id/ivGratitudeHeart"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent" />

                <EditText
                    android:id="@+id/etGratitude"
                    android:layout_width="match_parent"
                    android:layout_height="80dp"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/card_background_elevated"
                    android:gravity="top|start"
                    android:hint="“Lord, today I am grateful for...”"
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/text_tertiary"
                    android:padding="12dp"
                    android:textSize="13sp"
                    app:layout_constraintTop_toBottomOf="@id/lblGratitudeSub" />

                <Button
                    android:id="@+id/btnSaveGratitude"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/button_gold"
                    android:text="Save Entry"
                    android:textColor="@color/bg_dark"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    app:layout_constraintTop_toBottomOf="@id/etGratitude"
                    app:layout_constraintEnd_toEndOf="parent" />

                <LinearLayout
                    android:id="@+id/layoutGratitudeList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginTop="14dp"
                    app:layout_constraintTop_toBottomOf="@id/btnSaveGratitude" />

            </androidx.constraintlayout.widget.ConstraintLayout>

        </LinearLayout>
    </ScrollView>

</LinearLayout>
