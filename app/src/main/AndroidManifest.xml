<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Permissions required for personal launcher & guardian restrictions -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.ACCESS_NOTIFICATION_POLICY" />
    <uses-permission android:name="android.permission.KILL_BACKGROUND_PROCESSES" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.NYIRABYOLife">

        <!-- Main Home Launcher Activity -->
        <activity
            android:name=".ui.home.HomeActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:stateNotNeeded="true"
            android:clearTaskOnLaunch="true"
            android:theme="@style/Theme.NYIRABYOLife.Launcher">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- App Drawer -->
        <activity
            android:name=".ui.drawer.AppDrawerActivity"
            android:exported="true"
            android:theme="@style/Theme.NYIRABYOLife" />

        <!-- God First Module -->
        <activity
            android:name=".ui.godfirst.GodFirstActivity"
            android:exported="true"
            android:theme="@style/Theme.NYIRABYOLife" />

        <!-- Recovery Module (Private Sanctum) -->
        <activity
            android:name=".ui.recovery.RecoveryActivity"
            android:exported="true"
            android:theme="@style/Theme.NYIRABYOLife" />

        <activity
            android:name=".ui.recovery.UrgeCheckInActivity"
            android:exported="true"
            android:theme="@style/Theme.NYIRABYOLife" />

        <!-- Focus Timer Module -->
        <activity
            android:name=".ui.focus.FocusActivity"
            android:exported="true"
            android:theme="@style/Theme.NYIRABYOLife" />

        <!-- WhatsApp Windows Module -->
        <activity
            android:name=".ui.whatsapp.WhatsAppWindowActivity"
            android:exported="true"
            android:theme="@style/Theme.NYIRABYOLife" />

        <!-- App Restrictions & Blocker Settings -->
        <activity
            android:name=".ui.restriction.AppRestrictionsActivity"
            android:exported="true"
            android:theme="@style/Theme.NYIRABYOLife" />

        <!-- Permissions Guardian Setup Hub -->
        <activity
            android:name=".ui.permissions.PermissionsHubActivity"
            android:exported="true"
            android:theme="@style/Theme.NYIRABYOLife" />

        <!-- Real-Time Block Shield Screen -->
        <activity
            android:name=".ui.shield.BlockShieldActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:excludeFromRecents="true"
            android:theme="@style/Theme.NYIRABYOLife" />

        <!-- Full Discipline Lock Screen -->
        <activity
            android:name=".ui.lock.DisciplineLockActivity"
            android:exported="true"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:showForAllUsers="true"
            android:excludeFromRecents="true"
            android:launchMode="singleTask"
            android:theme="@style/Theme.NYIRABYOLife.Launcher" />

        <!-- Settings & Data Privacy -->
        <activity
            android:name=".ui.settings.SettingsActivity"
            android:exported="true"
            android:theme="@style/Theme.NYIRABYOLife" />

        <!-- Guardian Accessibility Service for Real-Time App Blocking -->
        <service
            android:name=".service.NyirabyoGuardianService"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <!-- FileProvider for offline export -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>

</manifest>